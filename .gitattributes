# .gitattributes  (repo root)
# Let Git normalise line endings: stored as LF in the repo, checked out natively.
* text=auto

# Windows-only files keep CRLF
*.sln     text eol=crlf
*.slnx    text eol=crlf
*.ps1     text eol=crlf
*.cmd     text eol=crlf

# Shell scripts must be LF or Linux runners fail ("bad interpreter")
*.sh      text eol=lf

# Binary files: never touch
*.png     binary
*.jpg     binary
*.pfx     binary
*.snk     binary